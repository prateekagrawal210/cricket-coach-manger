function startAuction(){auctionPool=[...PLAYERS].sort(()=>Math.random()-0.5);nextAuctionPlayer()}
function nextAuctionPlayer(){auctionPool=auctionPool.filter(p=>!state.soldPlayers.has(p.name));
  if(!auctionPool.length||state.squad.length>=25){document.getElementById('currPlayerName').textContent='Auction Complete!';document.getElementById('currPlayerRole').textContent='';document.getElementById('currPlayerBase').textContent='';document.getElementById('currBidInput').style.display='none';document.getElementById('bidStatus').textContent='Ready for match';return}
  currentAuctionPlayer=auctionPool.shift();document.getElementById('currPlayerName').textContent=currentAuctionPlayer.name;document.getElementById('currPlayerRole').textContent=currentAuctionPlayer.role;document.getElementById('currPlayerBase').textContent='Base: ₹'+currentAuctionPlayer.base.toFixed(2)+' Cr';document.getElementById('currBidInput').value=currentAuctionPlayer.base;document.getElementById('currBidInput').style.display='inline-block';document.getElementById('bidStatus').textContent='';updateAuctionCounts()}
function updateAuctionCounts(){document.getElementById('remainingCount').textContent=auctionPool.length;document.getElementById('soldCount').textContent=state.squad.length;document.getElementById('budgetDisplay').textContent='₹'+state.budget.toFixed(2)+' Cr';document.getElementById('squadCount').textContent=state.squad.length}
function bidCurrentPlayer(){if(!currentAuctionPlayer)return;const bid=parseFloat(document.getElementById('currBidInput').value);const p=currentAuctionPlayer;
  if(isNaN(bid)||bid<p.base)return toast('Min ₹'+p.base.toFixed(2));if(bid>state.budget)return toast('Budget kam');
  // Aukaat based chance
  const chance=Math.min(0.92,0.48+(bid-p.base)*0.28+(p.base>1.4?0.05:0));
  if(Math.random()<chance){state.budget=Math.round((state.budget-bid)*100)/100;state.squad.push({name:p.name,role:p.role,price:bid,rating:70+Math.floor(Math.random()*20)});state.soldPlayers.add(p.name);save();document.getElementById('bidStatus').innerHTML='<span style="color:var(--success)">✅ Sold to you!</span>';toast('✅ '+p.name);setTimeout(nextAuctionPlayer,600)}
  else{document.getElementById('bidStatus').innerHTML='<span style="color:var(--danger)">❌ Outbid by another team</span>';state.soldPlayers.add(p.name);setTimeout(nextAuctionPlayer,600)}
  updateAuctionCounts()}
