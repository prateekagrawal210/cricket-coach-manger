  document.getElementById('packPlayerName').textContent=p.name;document.getElementById('packPlayerRole').textContent=p.role+' • '+p.rating;document.getElementById('packResult').style.display='block';save();updateUI();document.getElementById('shopCoins').textContent=state.coins}
function claimPack(){if(!pendingPack)return;if(state.squad.some(s=>s.name===pendingPack.name))toast('Already have');else{state.squad.push({name:pendingPack.name,role:pendingPack.role,price:0.5,rating:pendingPack.rating});save();toast(pendingPack.name+' added')}pendingPack=null;document.getElementById('packResult').style.display='none'}
const ACHIEVE_DEFS=[{id:'win1',name:'First Win',desc:'1 win',check:s=>(s.stats.wins||0)>=1},{id:'win5',name:'5 Wins',desc:'5 wins',check:s=>(s.stats.wins||0)>=5},{id:'six10',name:'Six Machine',desc:'10 sixes',check:s=>(s.stats.sixes||0)>=10},{id:'level3',name:'Rising',desc:'Level 3',check:s=>s.careerLevel>=3},{id:'level8',name:'National',desc:'Level 8',check:s=>s.careerLevel>=8}];
function unlockAchievement(id){state.achievements=state.achievements||{};if(state.achievements[id])return;state.achievements[id]=true;state.coins+=25;save();toast('🏅 +25 coins')}
function checkAchievements(){ACHIEVE_DEFS.forEach(a=>{if(a.check(state))unlockAchievement(a.id)})}
function openAchievements(){goTo('achieveMode');document.getElementById('achieveList').innerHTML=ACHIEVE_DEFS.map(a=>{const d=state.achievements?.[a.id];return`<div class="card" style="cursor:default;text-align:left;margin-bottom:5px;border-color:\( {d?'var(--accent)':'var(--border')}"><strong> \){d?'✅':'🔒'} \( {a.name}</strong><p style="color:var(--muted);font-size:.78rem"> \){a.desc}</p></div>`}).join('')}
function openTraining(){goTo('trainMode');document.getElementById('trainCoins').textContent=state.coins;const players=state.careerPlayers.length?state.careerPlayers:state.squad;if(!players.length){document.getElementById('trainList').innerHTML='<p style="color:var(--muted)">No players</p>';return}
  const today=new Date().toDateString();document.getElementById('trainList').innerHTML=players.map((p,i)=>{const key=p.name+'_'+today;const done=state.trainingDone?.[key];return`<div class="card" style="cursor:default"><h3 style="font-size:.78rem">\( {p.name}</h3><p> \){p.role} • ${p.rating||70}</p><button class="btn btn-sm" style="margin-top:3px" \( {done?'disabled':''} onclick="trainPlayer( \){i})">${done?'Done':'Train 40'}</button></div>`}).join('')}
function trainPlayer(i){const players=state.careerPlayers.length?state.careerPlayers:state.squad;const p=players[i];if(!p||state.coins<40)return toast('Coins kam');const today=new Date().toDateString();const key=p.name+'_'+today;state.trainingDone=state.trainingDone||{};if(state.trainingDone[key])return toast('Already');state.coins-=40;p.rating=Math.min(99,(p.rating||70)+1);state.trainingDone[key]=true;save();updateUI();openTraining();toast(p.name+' → '+p.rating)}
let netsState=null;
function openNets(){goTo('netsMode');netsState=null;document.getElementById('netsScore').textContent='0';document.getElementById('netsBall').textContent='0';document.getElementById('netsPrompt').textContent='Ready?';document.getElementById('netsBtns').innerHTML='<button class="btn" onclick="startNets()">▶ Start</button>'}
function startNets(){netsState={score:0,ball:0};nextNetBall()}
function nextNetBall(){if(!netsState||netsState.ball>=6){const c=Math.floor((netsState?.score||0)/2);state.coins+=c;save();updateUI();document.getElementById('netsPrompt').textContent='Over! +'+c;document.getElementById('netsBtns').innerHTML='<button class="btn" onclick="startNets()">Again</button>';return}
  netsState.ball++;document.getElementById('netsBall').textContent=netsState.ball;document.getElementById('netsPrompt').textContent='Ball '+netsState.ball;
  document.getElementById('netsBtns').innerHTML=`<button class="btn btn-sm" onclick="netShot('early')">Early</button><button class="btn btn-sm" onclick="netShot('perfect')">Perfect</button><button class="btn btn-sm" onclick="netShot('late')">Late</button>`}
function netShot(t){let r=0;if(t==='perfect')r=Math.random()<0.4?6:(Math.random()<0.7?4:2);else if(t==='early')r=Math.random()<0.3?4:(Math.random()<0.5?1:0);else r=Math.random()<0.25?2:(Math.random()<0.5?1:0);netsState.score+=r;document.getElementById('netsScore').textContent=netsState.score;toast(t.toUpperCase()+' → '+r);setTimeout(nextNetBall,350)}
function openTournament(){goTo('cupMode');if(!cup||cup.done){const t=['Your XI','Warriors','Titans','Strikers'].sort(()=>Math.random()-0.5);cup={semis:[[t[0],t[1]],[t[2],t[3]]],final:null,stage:'semi1',winners:[],done:false}}renderCup()}
function renderCup(){document.getElementById('cupBracket').innerHTML=`<p><strong>Semi 1:</strong> ${cup.semis[0][0]} vs ${cup.semis[0][1]} ${cup.winners[0]?'→ '+cup.winners[0]:''}</p><p style="margin-top:4px"><strong>Semi 2:</strong> ${cup.semis[1][0]} vs ${cup.semis[1][1]} ${cup.winners[1]?'→ '+cup.winners[1]:''}</p><p style="margin-top:4px"><strong>Final:</strong> ${cup.final?cup.final[0]+' vs '+cup.final[1]:'TBD'} ${cup.champion?'→ '+cup.champion:''}</p>`;document.getElementById('cupPlayBtn').style.display=cup.done?'none':'inline-block'}
function playCupMatch(){let a,b;if(cup.stage==='semi1'){a=cup.semis[0][0];b=cup.semis[0][1]}else if(cup.stage==='semi2'){a=cup.semis[1][0];b=cup.semis[1][1]}else{a=cup.final[0];b=cup.final[1]}
  const w=Math.random()<(a==='Your XI'?0.62:0.5)?a:b;toast(a+' vs '+b+' → '+w);
  if(cup.stage==='semi1'){cup.winners[0]=w;cup.stage='semi2'}else if(cup.stage==='semi2'){cup.winners[1]=w;cup.final=[cup.winners[0],cup.winners[1]];cup.stage='final'}
  else{cup.champion=w;cup.done=true;if(w==='Your XI'){state.coins+=150;state.careerXP+=40;save();updateUI();toast('🏆 Cup jeet gaye!')}}renderCup()}
function openFeedback(){feedbackRating=0;document.getElementById('feedbackText').value='';document.getElementById('ratingText').textContent='Rating select karo';document.querySelectorAll('#starRating span').forEach(s=>s.classList.remove('active'));document.getElementById('feedbackModal').classList.add('show')}
function closeFeedback(){document.getElementById('feedbackModal').classList.remove('show')}
function setRating(n){feedbackRating=n;document.querySelectorAll('#starRating span').forEach((s,i)=>s.classList.toggle('active',i<n));document.getElementById('ratingText').textContent=n+' star'+(n>1?'s':'')}
function submitFeedback(){const t=document.getElementById('feedbackText').value.trim();if(!feedbackRating&&!t)return toast('Kuch to do');const f=`CCM Feedback\nRating: \( {feedbackRating}/5\n \){t}\nLevel: ${state.careerLevel}`;navigator.clipboard.writeText(f).then(()=>toast('✅ Copied')).catch(()=>toast('Copy failed'));closeFeedback()}

load();updateUI();checkAchievements();
</script>
</body>
</html>
