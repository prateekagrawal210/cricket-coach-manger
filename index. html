<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Cricket Coach Manager - Complete</title>
<style>
:root{--bg:#070b14;--card:#121a2b;--card2:#1a2438;--accent:#00d4a8;--accent2:#ff6b35;--gold:#f5c518;--text:#f0f4fc;--muted:#8b9bb4;--danger:#ff4757;--success:#2ed573;--border:rgba(255,255,255,0.08)}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--text);min-height:100vh;overflow-x:hidden}
#intro{position:fixed;inset:0;z-index:1000;background:#000;display:flex;flex-direction:column;align-items:center;justify-content:center}
#intro.hidden{animation:introOut .6s ease forwards;pointer-events:none}
@keyframes introOut{to{opacity:0;transform:scale(1.03)}}
.intro-logo{font-size:58px}.intro-title{font-size:1.45rem;font-weight:800;margin-top:8px;background:linear-gradient(90deg,#00d4a8,#f5c518);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.intro-sub{color:var(--muted);margin-top:4px;font-size:.85rem}.intro-creator{color:var(--gold);margin-top:8px;font-weight:600}
.intro-skip{position:absolute;bottom:16px;right:16px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);color:#fff;padding:6px 12px;border-radius:16px;cursor:pointer;font-size:.78rem}
.screen{display:none;min-height:100vh;padding:11px;max-width:1100px;margin:0 auto}
.screen.active{display:block;animation:fadeIn .22s ease}
@keyframes fadeIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
.btn{background:linear-gradient(135deg,var(--accent),#00a888);color:#001510;border:none;padding:9px 14px;font-size:.88rem;font-weight:700;border-radius:9px;cursor:pointer}
.btn:hover{transform:translateY(-1px)}.btn:disabled{opacity:.45;cursor:not-allowed}
.btn-secondary{background:rgba(255,255,255,.06);color:var(--text);border:1.5px solid var(--border)}
.btn-gold{background:linear-gradient(135deg,var(--gold),#d4a010);color:#1a1200}
.btn-danger{background:linear-gradient(135deg,var(--danger),#c0392b);color:#fff}
.btn-sm{padding:5px 8px;font-size:.74rem}
.header{display:flex;justify-content:space-between;align-items:center;margin-bottom:9px;flex-wrap:wrap;gap:6px}
.header h2{font-size:1.08rem;font-weight:700}
.back-btn{background:var(--card);border:1px solid var(--border);color:var(--text);padding:5px 9px;border-radius:7px;cursor:pointer;font-size:.78rem}
#splash{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:22px 10px}
.logo-box{width:76px;height:76px;border-radius:17px;background:linear-gradient(145deg,#00d4a8,#0077cc);display:flex;align-items:center;justify-content:center;font-size:34px;margin-bottom:8px}
h1{font-size:1.4rem;font-weight:800;margin-bottom:3px}.tagline{color:var(--muted);font-size:.83rem}.creator{color:var(--gold);font-weight:600;margin:6px 0 11px}
.currency-bar{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;margin-bottom:8px}
.currency-pill{background:var(--card);border:1px solid var(--border);border-radius:13px;padding:4px 9px;font-size:.78rem;font-weight:600}
.gold-c{color:var(--gold)}.green-c{color:var(--accent)}
.mode-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:8px;margin:8px 0}
.mode-card{background:linear-gradient(160deg,var(--card2),var(--card));border:1px solid var(--border);border-radius:12px;padding:12px 8px;cursor:pointer;text-align:center}
.mode-card:hover{border-color:var(--accent);transform:translateY(-2px)}
.mode-card .icon{font-size:1.6rem;margin-bottom:3px}.mode-card h3{font-size:.88rem;font-weight:800}.mode-card p{font-size:.7rem;color:var(--muted)}
.hub-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(68px,1fr));gap:6px;margin:8px 0}
.hub-btn{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:8px 2px;text-align:center;cursor:pointer}
.hub-btn:hover{border-color:var(--accent)}.hub-btn .icon{font-size:1.1rem;margin-bottom:2px}.hub-btn div{font-size:.64rem;font-weight:600}
.info-bar{background:var(--card);border-radius:8px;padding:7px 10px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:5px;margin-bottom:8px;border:1px solid var(--border);font-size:.8rem}
.info-bar strong{color:var(--accent)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(115px,1fr));gap:7px}
.card{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:10px 6px;cursor:pointer;text-align:center}
.card:hover{border-color:var(--accent)}.card .icon{font-size:1.35rem;margin-bottom:2px}.card h3{font-size:.8rem}.card p{font-size:.66rem;color:var(--muted)}
.overs-select{display:flex;gap:5px;justify-content:center;flex-wrap:wrap;margin:7px 0}
.over-btn{background:var(--card);border:2px solid var(--border);color:var(--text);padding:6px 11px;border-radius:8px;cursor:pointer;font-weight:700;min-width:46px;font-size:.82rem}
.over-btn.active,.over-btn:hover{border-color:var(--accent);color:var(--accent);background:rgba(0,212,168,.1)}
.match-box{background:var(--card);border-radius:11px;padding:10px;border:1px solid var(--border);margin-top:6px}
.scoreboard{display:flex;justify-content:space-around;text-align:center;background:linear-gradient(135deg,#0a1220,#121c30);border-radius:10px;padding:8px;margin-bottom:6px}
.scoreboard .runs{font-size:1.35rem;font-weight:800;color:var(--accent)}
.ball-log{background:#0a1220;border-radius:8px;padding:6px;min-height:65px;max-height:115px;overflow-y:auto;font-size:.78rem;margin-bottom:6px;line-height:1.4;border:1px solid var(--border)}
.ball-log .six{color:var(--gold);font-weight:800}.ball-log .four{color:var(--accent);font-weight:700}.ball-log .out{color:var(--danger);font-weight:800}
.action-btns{display:flex;flex-wrap:wrap;gap:5px;justify-content:center;margin-top:5px}
.result-box{background:var(--card);border-radius:11px;padding:14px;text-align:center;border:1px solid var(--border);margin-top:6px}
.result-box .big{font-size:2rem;margin-bottom:3px}
.auction-card{background:linear-gradient(160deg,#152038,#0e1628);border:2px solid rgba(0,212,168,.25);border-radius:11px;padding:11px;text-align:center;margin-bottom:7px}
#toast{position:fixed;bottom:12px;left:50%;transform:translateX(-50%);background:var(--card);color:var(--text);padding:7px 13px;border-radius:8px;border:1px solid var(--accent);display:none;z-index:999;font-size:.82rem;max-width:92%;text-align:center}
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.78);z-index:2000;display:none;align-items:center;justify-content:center;padding:10px}
.modal-overlay.show{display:flex}
.modal{background:var(--card);border:1px solid var(--border);border-radius:13px;padding:13px;width:100%;max-width:370px;max-height:88vh;overflow-y:auto}
.modal h3{margin-bottom:6px;font-size:1rem}
.stars{display:flex;gap:5px;justify-content:center;margin:6px 0;font-size:1.35rem;cursor:pointer}
.stars span{opacity:.35}.stars span.active{opacity:1;color:var(--gold)}
textarea,input[type="text"]{width:100%;background:var(--bg);border:1px solid var(--border);border-radius:7px;color:var(--text);padding:7px;font-size:.86rem;margin:4px 0}
textarea{min-height:65px;resize:vertical}
.note{text-align:center;color:var(--muted);font-size:.68rem;margin-top:9px}
.player-chip{background:var(--card2);border:1px solid var(--border);border-radius:6px;padding:3px 6px;font-size:.72rem;margin:2px;display:inline-block}
.player-chip.star{border-color:var(--gold);color:var(--gold)}
.badge{display:inline-block;padding:1px 5px;border-radius:6px;font-size:.66rem;font-weight:600}
.badge.pp{background:rgba(0,212,168,.15);color:var(--accent)}
.newspaper{background:#151515;border:2px solid #333;border-radius:8px;padding:10px;margin:8px 0;font-family:Georgia,serif}
.newspaper .headline{font-size:1.05rem;font-weight:700;color:var(--gold);margin-bottom:3px}
.newspaper .sub{font-size:.78rem;color:var(--muted)}
@media (orientation:landscape) and (max-height:500px){
  .screen{padding:5px 10px}.header{margin-bottom:4px}.logo-box{width:48px;height:48px;font-size:22px}
  .mode-grid{grid-template-columns:repeat(3,1fr)}.hub-grid{grid-template-columns:repeat(8,1fr)}
  .ball-log{max-height:75px;min-height:40px}.scoreboard .runs{font-size:1.15rem}
}
</style>
</head>
<body>

<div id="intro">
  <div class="intro-logo">🏏</div>
  <div class="intro-title">CRICKET COACH MANAGER</div>
  <div class="intro-sub">Complete Edition</div>
  <div class="intro-creator">Created by Prateek Agrawal</div>
  <button class="intro-skip" onclick="skipIntro()">Skip →</button>
</div>

<div id="splash" class="screen active">
  <div class="logo-box">🏏</div>
  <h1>Cricket Coach Manager</h1>
  <p class="tagline">Build • Coach • Conquer</p>
  <p class="creator">Created by Prateek Agrawal</p>
  <button class="btn" onclick="goTo('mainMenu')">▶ Start Game</button>
  <p class="note">v9 • Full + Batch 2 Merged</p>
</div>

<div id="mainMenu" class="screen">
  <div class="header">
    <h2>🏏 Cricket Coach Manager</h2>
    <button class="back-btn" onclick="goTo('splash')">← Home</button>
  </div>
  <div class="currency-bar">
    <div class="currency-pill">⭐ <strong id="careerLevel" class="green-c">1</strong></div>
    <div class="currency-pill">XP <strong id="careerXP" class="green-c">0</strong></div>
    <div class="currency-pill">🪙 <strong id="coinDisplay" class="gold-c">200</strong></div>
    <div class="currency-pill">😍 <strong id="fanDisplay" class="green-c">50</strong></div>
  </div>
  <div class="mode-grid">
    <div class="mode-card" onclick="openIPL()"><div class="icon">🏆</div><h3>IPL Manager</h3><p>Auction • Squad</p></div>
    <div class="mode-card" onclick="startCareer()"><div class="icon">🌟</div><h3>Career Mode</h3><p>Season • National</p></div>
    <div class="mode-card" onclick="openInternational()"><div class="icon">🌍</div><h3>International</h3><p>Play</p></div>
  </div>
  <div class="hub-grid">
    <div class="hub-btn" onclick="claimDaily()"><div class="icon">🎁</div><div>Daily</div></div>
    <div class="hub-btn" onclick="openShop()"><div class="icon">🛒</div><div>Shop</div></div>
    <div class="hub-btn" onclick="openTransfer()"><div class="icon">🔄</div><div>Transfer</div></div>
    <div class="hub-btn" onclick="openCoaches()"><div class="icon">👔</div><div>Coaches</div></div>
    <div class="hub-btn" onclick="openAchievements()"><div class="icon">🏅</div><div>Achieve</div></div>
    <div class="hub-btn" onclick="openTraining()"><div class="icon">💪</div><div>Train</div></div>
    <div class="hub-btn" onclick="openNets()"><div class="icon">🏏</div><div>Nets</div></div>
    <div class="hub-btn" onclick="openTournament()"><div class="icon">🏆</div><div>Cup</div></div>
    <div class="hub-btn" onclick="openSaves()"><div class="icon">💾</div><div>Saves</div></div>
    <div class="hub-btn" onclick="toggleSound()"><div class="icon" id="soundIcon">🔊</div><div>Sound</div></div>
    <div class="hub-btn" onclick="openFeedback()"><div class="icon">💬</div><div>Feedback</div></div>
  </div>
  <p class="note" id="unlockNote">Level 3: IPL • Level 8: National</p>
</div>

<!-- CAREER SETUP -->
<div id="careerSetup" class="screen">
  <div class="header"><h2>🎯 Career Setup</h2></div>
  <div class="info-bar"><span>Team: <strong id="setupTeamName">—</strong></span><span>Stadium: <strong id="setupStadium">—</strong></span></div>
  <p style="color:var(--muted);font-size:.84rem;margin-bottom:6px;">20 players milenge. Ek ka naam tum rakh sakte ho.</p>
  <input type="text" id="starPlayerName" placeholder="Star Player ka naam..." maxlength="18">
  <div id="setupPlayerList" style="max-height:200px;overflow-y:auto;margin:8px 0;"></div>
  <div style="text-align:center"><button class="btn btn-gold" onclick="confirmCareerSetup()">✅ Confirm</button></div>
</div>

<div id="careerCountry" class="screen">
  <div class="header"><h2>Select Country</h2><button class="back-btn" onclick="goTo('mainMenu')">← Back</button></div>
  <div class="grid" id="countryGrid"></div>
</div>

<div id="careerState" class="screen">
  <div class="header"><h2>Select City</h2><button class="back-btn" onclick="goTo('careerCountry')">← Back</button></div>
  <p style="color:var(--muted);margin-bottom:8px;font-size:.84rem;" id="selectedCountryText"></p>
  <div class="grid" id="stateGrid"></div>
</div>

<div id="careerDash" class="screen">
  <div class="header"><h2>Career Dashboard</h2><button class="back-btn" onclick="goTo('mainMenu')">← Menu</button></div>
  <div class="info-bar"><span>Team: <strong id="dashTeam">—</strong></span><span>Stadium: <strong id="dashStadium">—</strong></span></div>
  <div class="info-bar">
    <span>Level: <strong id="dashLevel">1</strong></span>
    <span>XP: <strong id="dashXP">0</strong></span>
    <span>Season: <strong id="dashSeason">1</strong></span>
    <span>Pts: <strong id="dashPoints">0</strong></span>
  </div>
  <div class="grid">
    <div class="card" onclick="openOversSelect('career')"><div class="icon">🏟️</div><h3>Play Match</h3><p>Season</p></div>
    <div class="card" onclick="viewCareerSquad()"><div class="icon">👥</div><h3>Squad</h3><p>20 Players</p></div>
    <div class="card" onclick="openSeasonTable()"><div class="icon">📊</div><h3>Points Table</h3><p>Standing</p></div>
    <div class="card" id="nationalCard" onclick="playNational()" style="display:none"><div class="icon">🇮🇳</div><h3>National</h3><p>Level 8+</p></div>
    <div class="card" onclick="openCareerStats()"><div class="icon">📈</div><h3>Stats</h3><p>Detailed</p></div>
    <div class="card" onclick="resetCareerConfirm()"><div class="icon">🔄</div><h3>Reset</h3><p>New Career</p></div>
  </div>
</div>

<div id="careerSquadView" class="screen">
  <div class="header"><h2>👥 Squad</h2><button class="back-btn" onclick="goTo('careerDash')">← Back</button></div>
  <div id="careerSquadList" class="grid"></div>
</div>

<div id="seasonTable" class="screen">
  <div class="header"><h2>📊 Points Table</h2><button class="back-btn" onclick="goTo('careerDash')">← Back</button></div>
  <div id="tableBody" class="match-box"></div>
</div>

<div id="careerStats" class="screen">
  <div class="header"><h2>📈 Stats</h2><button class="back-btn" onclick="goTo('careerDash')">← Back</button></div>
  <div class="match-box" id="statsBody"></div>
</div>

<div id="oversSelect" class="screen">
  <div class="header"><h2>Select Overs</h2><button class="back-btn" onclick="goTo(lastScreenBeforeOvers)">← Back</button></div>
  <div class="overs-select">
    <button class="over-btn" onclick="selectOvers(2)">2</button>
    <button class="over-btn active" onclick="selectOvers(5)">5</button>
    <button class="over-btn" onclick="selectOvers(10)">10</button>
    <button class="over-btn" onclick="selectOvers(20)">20</button>
  </div>
  <p style="text-align:center;color:var(--muted);margin-bottom:6px">Selected: <strong id="selectedOversText">5 Overs</strong></p>
  <div class="overs-select">
    <button class="over-btn" id="fieldAttack" onclick="setField('attack')">⚔️ Attack</button>
    <button class="over-btn active" id="fieldBalanced" onclick="setField('balanced')">⚖️ Balanced</button>
    <button class="over-btn" id="fieldDefend" onclick="setField('defend')">🛡️ Defend</button>
  </div>
  <div id="pitchWeatherPreview" style="text-align:center;margin:8px 0;font-size:.82rem;color:var(--muted)"></div>
  <div style="text-align:center;margin-top:10px"><button class="btn btn-gold" onclick="confirmOversAndStart()">▶ Start Match</button></div>
</div>

<!-- IPL -->
<div id="iplMode" class="screen">
  <div class="header"><h2>🏆 IPL Manager</h2><button class="back-btn" onclick="goTo('mainMenu')">← Menu</button></div>
  <div class="info-bar">
    <span>Team: <strong id="iplTeamName">Select</strong></span>
    <span>Budget: <strong id="budgetDisplay">₹30 Cr</strong></span>
    <span>Squad: <strong id="squadCount">0</strong>/25</span>
  </div>
  <div id="teamSelectArea"><div class="grid" id="iplTeamGrid"></div></div>
  <div id="auctionArea" style="display:none">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:7px;flex-wrap:wrap;gap:5px">
      <h3 style="font-size:.95rem">🔥 Auction</h3>
      <div>
        <button class="btn btn-secondary btn-sm" onclick="showSquad()">Squad</button>
        <button class="btn btn-gold btn-sm" onclick="goToMatchSetup()">Setup</button>
      </div>
    </div>
    <div id="currentPlayerCard" class="auction-card">
      <div id="currPlayerName" style="font-size:1.2rem;font-weight:800">—</div>
      <div id="currPlayerRole" style="color:var(--muted);font-size:.82rem">—</div>
      <div id="currPlayerBase" style="color:var(--gold);margin:5px 0">Base: ₹0 Cr</div>
      <div style="display:flex;gap:5px;justify-content:center;flex-wrap:wrap">
        <input type="number" id="currBidInput" min="0.1" step="0.05" value="0.5" style="width:70px;padding:6px;border-radius:7px;border:2px solid var(--border);background:#0a1220;color:var(--text);text-align:center;font-weight:700">
        <button class="btn btn-sm" onclick="bidCurrentPlayer()">BID</button>
        <button class="btn btn-secondary btn-sm" onclick="skipPlayer()">Skip</button>
      </div>
      <div id="bidStatus" style="margin-top:6px;font-size:.82rem"></div>
    </div>
    <div style="text-align:center;color:var(--muted);font-size:.8rem">Left: <strong id="remainingCount">0</strong> | Bought: <strong id="soldCount">0</strong></div>
  </div>
  <div id="squadArea" style="display:none">
    <div style="display:flex;justify-content:space-between;margin-bottom:6px">
      <h3>Squad (<span id="squadTotal">0</span>)</h3>
      <button class="btn btn-secondary btn-sm" onclick="hideSquad()">← Back</button>
    </div>
    <div id="squadListFull" class="grid"></div>
  </div>
  <div id="matchSetupArea" style="display:none">
    <div style="display:flex;justify-content:space-between;margin-bottom:6px">
      <h3>Match Setup</h3>
      <button class="btn btn-secondary btn-sm" onclick="backFromSetup()">← Back</button>
    </div>
    <p style="color:var(--muted);font-size:.82rem;margin-bottom:5px">Opponent:</p>
    <div class="grid" id="oppTeamGrid" style="margin-bottom:8px"></div>
    <p style="color:var(--muted);font-size:.82rem;margin-bottom:5px">XI:</p>
    <div id="xiSelectArea" class="grid" style="margin-bottom:6px"></div>
    <div class="info-bar"><span>Bat: <strong id="batCount">0</strong>/6</span><span>Bowl: <strong id="bowlCount">0</strong>/5</span></div>
    <div style="text-align:center;margin-top:8px"><button class="btn btn-gold" onclick="confirmXIAndPlay()">▶ Play</button></div>
  </div>
</div>

<div id="intlMode" class="screen">
  <div class="header"><h2>International</h2><button class="back-btn" onclick="goTo('mainMenu')">← Menu</button></div>
  <div id="intlSelect"><div class="grid" id="intlTeamGrid"></div></div>
  <div id="opponentSelect" style="display:none">
    <p style="margin-bottom:6px">vs <strong id="myIntlTeam"></strong></p>
    <div class="grid" id="opponentGrid"></div>
  </div>
</div>

<div id="matchScreen" class="screen">
  <div class="header"><h2 id="matchTitle">Match</h2><button class="back-btn" onclick="exitMatch()">← Exit</button></div>
  <div id="tossPhase" class="match-box" style="text-align:center">
    <h3>🪙 Toss</h3>
    <p id="tossTeams" style="color:var(--muted);margin:6px 0;font-size:.88rem"></p>
    <div class="action-btns">
      <button class="btn" onclick="doToss('Heads')">Heads</button>
      <button class="btn btn-secondary" onclick="doToss('Tails')">Tails</button>
    </div>
  </div>
  <div id="choicePhase" class="match-box" style="display:none;text-align:center">
    <h3 id="tossResultText"></h3>
    <p id="choicePrompt" style="color:var(--muted);margin:6px 0"></p>
    <div class="action-btns" id="choiceBtns"></div>
  </div>
  <div id="playPhase" class="match-box" style="display:none">
    <div class="scoreboard">
      <div><h3 id="batTeamName" style="font-size:.72rem;color:var(--muted)">Bat</h3><div class="runs" id="batScore">0/0</div><div id="oversDisplay" style="font-size:.7rem;color:var(--muted)"></div></div>
      <div style="align-self:center;color:var(--muted)">vs</div>
      <div><h3 id="bowlTeamName" style="font-size:.72rem;color:var(--muted)">Bowl</h3><div class="runs" id="targetDisplay">—</div><div id="needDisplay" style="font-size:.7rem;color:var(--muted)"></div></div>
    </div>
    <div id="conditionsBar" style="text-align:center;font-size:.72rem;color:var(--muted);margin-bottom:4px"></div>
    <div class="ball-log" id="ballLog"></div>
    <div id="userActions" class="action-btns"></div>
    <div id="drsArea" style="display:none;text-align:center;margin-top:6px">
      <button class="btn btn-sm" onclick="useDRS()">📺 Review (DRS)</button>
    </div>
  </div>
  <div id="resultPhase" class="result-box" style="display:none"></div>
</div>

<!-- Batch 2 Screens -->
<div id="transferMode" class="screen">
  <div class="header"><h2>🔄 Transfer Market</h2><button class="back-btn" onclick="goTo('mainMenu')">← Menu</button></div>
  <div class="info-bar"><span>🪙 <strong id="transferCoins">0</strong></span></div>
