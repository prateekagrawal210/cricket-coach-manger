function setField(m){state.fieldSetting=m;['fieldAttack','fieldBalanced','fieldDefend'].forEach(id=>document.getElementById(id)?.classList.remove('active'));document.getElementById('field'+m.charAt(0).toUpperCase()+m.slice(1))?.classList.add('active')}
function confirmOversAndStart(){startMatch(matchMode)}

// ===== MATCH =====
function startMatch(mode){
  let myTeam,oppTeam;
  if(mode==='career'||mode==='national'){myTeam=mode==='national'?(state.country+' National'):state.domesticTeam;const others=COUNTRIES.filter(c=>c.name!==state.country);oppTeam=others[Math.floor(Math.random()*others.length)].name+(mode==='national'?'':' XI')}
  else if(mode==='ipl'){myTeam=state.iplTeam;oppTeam=selectedOpp}
  else{myTeam=state.myIntlTeam;oppTeam=selectedOpp}
  match={mode,myTeam,oppTeam,overLimit:selectedOvers,maxWickets:10,score:0,wickets:0,balls:0,innings:1,target:0,userBatting:true,striker:'—',nonStriker:'—',strikerRuns:0,strikerBalls:0,nonStrikerRuns:0,nonStrikerBalls:0,bowler:'—',bowlerRuns:0,bowlerWickets:0,bowlerBalls:0};
  // Rain chance
  if(Math.random()<0.16){const red=1+Math.floor(Math.random()*2);match.overLimit=Math.max(2,match.overLimit-red);toast('🌧️ Rain! Overs reduced to '+match.overLimit)}
  reviewsLeft=1;
  goTo('matchScreen');
  document.getElementById('matchTitle').textContent=myTeam+' vs '+oppTeam;
  document.getElementById('tossPhase').style.display='block';
  document.getElementById('choicePhase').style.display='none';
  document.getElementById('playPhase').style.display='none';
  document.getElementById('resultPhase').style.display='none';
  document.getElementById('ballLog').innerHTML='';
  document.getElementById('tossTeams').textContent=myTeam+' vs '+oppTeam+(mode==='career'||mode==='national'?' • '+state.careerStadium:'');
}
function doToss(choice){
  const result=Math.random()<0.5?'Heads':'Tails';const won=choice===result;
  document.getElementById('tossPhase').style.display='none';document.getElementById('choicePhase').style.display='block';
  document.getElementById('tossResultText').textContent=won?'🎉 Toss jeet gaye!':'😔 Toss haar gaye';
  document.getElementById('choicePrompt').textContent=won?'Bat ya Bowl?':'Opponent decide kar raha hai...';
  const btns=document.getElementById('choiceBtns');
  if(won) btns.innerHTML=`<button class="btn" onclick="chooseBatBowl(true)">Bat First</button><button class="btn btn-secondary" onclick="chooseBatBowl(false)">Bowl First</button>`;
  else{btns.innerHTML=`<p style="color:var(--muted)">Wait...</p>`;setTimeout(()=>chooseBatBowl(!(Math.random()<0.55)),900)}
}
function chooseBatBowl(u){match.userBatting=u;beginPlay()}
function beginPlay(){
  document.getElementById('choicePhase').style.display='none';document.getElementById('playPhase').style.display='block';
  initOnFieldPlayers();updateScoreboard();setUserActions();
  document.getElementById('conditionsBar').textContent=`Pitch: ${currentPitch?.name||'Balanced'} • Weather: ${currentWeather?.name||'Sunny'}`;
  addLog('🏟️ Match shuru! '+(match.userBatting?match.myTeam:match.oppTeam)+' batting • '+match.overLimit+' Ov');
  if(match.mode==='career'||match.mode==='national') addLog('📍 '+state.careerStadium);
  addLog(match.striker+' & '+match.nonStriker+' open. Bowler: '+match.bowler);
}
function initOnFieldPlayers(){
  let batPool,bowlPool;
  if((match.mode==='career'||match.mode==='national')&&state.careerPlayers.length){
    const avail=state.careerPlayers.filter(p=>!p.injured);
    const bats=avail.filter(p=>p.role.includes('Bat')||p.role.includes('WK')||p.role.includes('All'));
    const bowls=avail.filter(p=>p.role.includes('Bowl')||p.role.includes('All'));
    batPool=(bats.length?bats:avail).map(p=>p.name);bowlPool=(bowls.length?bowls:avail).map(p=>p.name);
  } else if(match.mode==='ipl'&&state.squad.length){batPool=state.squad.map(p=>p.name);bowlPool=batPool}
  else{batPool=['Batter 1','Batter 2'];bowlPool=['Bowler 1','Bowler 2']}
  match.striker=batPool[0]||'Batter 1';match.nonStriker=batPool[1]||'Batter 2';match.bowler=bowlPool[bowlPool.length-1]||'Bowler 1';
  match.strikerRuns=0;match.strikerBalls=0;match.nonStrikerRuns=0;match.nonStrikerBalls=0;match.bowlerRuns=0;match.bowlerWickets=0;match.bowlerBalls=0;
  updateOnFieldUI();
}
function updateOnFieldUI(){
  document.getElementById('strikerName')&&(document.getElementById('strikerName').textContent=match.striker);
  // simplified for length - full UI update similar to previous
}
function updateScoreboard(){
  document.getElementById('batTeamName').textContent=match.userBatting?match.myTeam:match.oppTeam;
  document.getElementById('bowlTeamName').textContent=match.userBatting?match.oppTeam:match.myTeam;
  document.getElementById('batScore').textContent=match.score+'/'+match.wickets;
  const overs=Math.floor(match.balls/6)+'.'+(match.balls%6);
  let ovText=overs+' / '+match.overLimit+' Ov';
  if(Math.floor(match.balls/6)<Math.min(2,Math.floor(match.overLimit/3)||1)) ovText+=' <span class="badge pp">PP</span>';
  document.getElementById('oversDisplay').innerHTML=ovText;
  if(match.innings===2){document.getElementById('targetDisplay').textContent='Target '+match.target;document.getElementById('needDisplay').textContent=match.target-match.score>0?(match.target-match.score)+' need':'Won!'}
  else{document.getElementById('targetDisplay').textContent='—';document.getElementById('needDisplay').textContent=''}
}
function setUserActions(){
  const a=document.getElementById('userActions');
  if(match.userBatting) a.innerHTML=`<button class="btn btn-sm" onclick="playBall('defend')">Defend</button><button class="btn btn-sm" onclick="playBall('single')">Single</button><button class="btn btn-sm" onclick="playBall('aggressive')">Aggressive</button><button class="btn btn-gold btn-sm" onclick="playBall('slog')">Slog</button>`;
  else a.innerHTML=`<button class="btn btn-sm" onclick="playBall('dot')">Dot</button><button class="btn btn-sm" onclick="playBall('line')">Good Line</button><button class="btn btn-sm" onclick="playBall('yorker')">Yorker</button><button class="btn btn-danger btn-sm" onclick="playBall('bouncer')">Bouncer</button>`;
}
function getModifiers(){
  let run=1,wicket=1;
  if(state.fieldSetting==='attack'){run*=1.1;wicket*=1.18} if(state.fieldSetting==='defend'){run*=0.9;wicket*=0.88}
  if(currentPitch){run*=currentPitch.run;wicket*=currentPitch.wicket} if(currentWeather){run*=currentWeather.run;wicket*=currentWeather.wicket}
  if(state.coaches.batting&&match.userBatting) run*=1.06;
  if(state.coaches.bowling&&!match.userBatting) wicket*=1.08;
  return {run,wicket};
}
function randomComment(t){const a=COMMENTARY[t]||[''];return a[Math.floor(Math.random()*a.length)]}
function playBall(action){
  if(!match) return;
  let runs=0,isOut=false,desc='';const r=Math.random();const m=getModifiers();
  if(match.userBatting){
    if(action==='defend'){if(r<0.07*m.wicket){isOut=true;desc='OUT! Caught'}else if(r<0.55){runs=0;desc='Dot'}else if(r<0.85){runs=1;desc='Single'}else{runs=2;desc='Two'}}
    else if(action==='single'){if(r<0.05*m.wicket){isOut=true;desc='OUT! Run out'}else if(r<0.72){runs=1;desc='Single'}else if(r<0.9){runs=2;desc='Two'}else{runs=0;desc='Dot'}}
    else if(action==='aggressive'){if(r<0.11*m.wicket){isOut=true;desc='OUT! Caught'}else if(r<0.35*m.run){runs=4;desc='FOUR!'}else if(r<0.55){runs=2;desc='Two'}else if(r<0.75){runs=1;desc='Single'}else{runs=0;desc='Missed'}}
    else if(action==='slog'){if(r<0.2*m.wicket){isOut=true;desc='OUT! Skied'}else if(r<0.4*m.run){runs=6;desc='SIX!!!'}else if(r<0.55*m.run){runs=4;desc='FOUR!'}else if(r<0.72){runs=1;desc='Mis-hit'}else{runs=0;desc='Miss'}}
  } else {
    if(action==='dot'){if(r<0.14){runs=1;desc='Single leaked'}else if(r<0.24){runs=4;desc='Edge FOUR'}else{runs=0;desc='Good dot'}}
    else if(action==='line'){if(r<0.12*m.wicket){isOut=true;desc='OUT! Bowled'}else if(r<0.22*m.wicket){isOut=true;desc='OUT! LBW'}else if(r<0.5){runs=0;desc='Beaten'}else if(r<0.75){runs=1;desc='Single'}else{runs=4;desc='Driven FOUR'}}
    else if(action==='yorker'){if(r<0.16*m.wicket){isOut=true;desc='OUT! Yorker'}else if(r<0.38){runs=0;desc='Excellent yorker'}else if(r<0.58){runs=1;desc='Squeezed'}else if(r<0.72){runs=4;desc='Full toss FOUR'}else{runs=0;desc='Dot'}}
    else if(action==='bouncer'){if(r<0.1*m.wicket){isOut=true;desc='OUT! Hooked'}else if(r<0.28){runs=6;desc='Pulled SIX'}else if(r<0.45){runs=4;desc='Upper cut FOUR'}else if(r<0.65){runs=0;desc='Ducked'}else{runs=1;desc='Glanced'}}
  }
  match.balls++;match.strikerBalls++;match.bowlerBalls++;
  if(isOut){
    match.wickets++;match.bowlerWickets++;
    addLog('<span class="out">🔴 '+match.striker+' - '+desc+'</span>');
    if(state.sound) addLog('<em style="color:var(--danger)">'+randomComment('out')+'</em>');
    document.getElementById('drsArea').style.display=reviewsLeft>0?'block':'none';
    lastOutDesc=desc;
    let pool=(match.mode==='career'||match.mode==='national')&&state.careerPlayers.length?state.careerPlayers.filter(p=>!p.injured).map(p=>p.name):['Next Batter'];
    match.striker=pool[Math.floor(Math.random()*pool.length)]||'Batter';match.strikerRuns=0;match.strikerBalls=0;
  } else {
    match.score+=runs;match.strikerRuns+=runs;match.bowlerRuns+=runs;
    if(runs===6){addLog('<span class="six">🚀 '+match.striker+' - '+desc+'</span>');if(state.sound)addLog('<em style="color:var(--gold)">'+randomComment('six')+'</em>');state.stats.sixes=(state.stats.sixes||0)+1}
    else if(runs===4){addLog('<span class="four">🔵 '+match.striker+' - '+desc+'</span>');if(state.sound)addLog('<em style="color:var(--accent)">'+randomComment('four')+'</em>');state.stats.fours=(state.stats.fours||0)+1}
    else if(runs===0) addLog('• '+desc);
    else addLog(match.striker+' - '+desc+' (+'+runs+')');
    if(runs%2===1){[match.striker,match.nonStriker]=[match.nonStriker,match.striker];[match.strikerRuns,match.nonStrikerRuns]=[match.nonStrikerRuns,match.strikerRuns];[match.strikerBalls,match.nonStrikerBalls]=[match.nonStrikerBalls,match.strikerBalls]}
  }
  if(match.balls%6===0){
    let pool=(match.mode==='career'||match.mode==='national')&&state.careerPlayers.length?state.careerPlayers.filter(p=>!p.injured&&(p.role.includes('Bowl')||p.role.includes('All'))).map(p=>p.name):['New Bowler'];
    if(!pool.length) pool=state.careerPlayers.filter(p=>!p.injured).map(p=>p.name);
    match.bowler=pool[Math.floor(Math.random()*pool.length)]||'Bowler';match.bowlerRuns=0;match.bowlerWickets=0;match.bowlerBalls=0;
    [match.striker,match.nonStriker]=[match.nonStriker,match.striker];[match.strikerRuns,match.nonStrikerRuns]=[match.nonStrikerRuns,match.strikerRuns];[match.strikerBalls,match.nonStrikerBalls]=[match.nonStrikerBalls,match.strikerBalls];
    addLog('<em>Over complete. New bowler: '+match.bowler+'</em>');
  }
  updateScoreboard();
  if(match.balls>=match.overLimit*6||match.wickets>=match.maxWickets) endInnings();
}
function useDRS(){
  if(reviewsLeft<=0) return toast('No reviews left');
  reviewsLeft--;document.getElementById('drsArea').style.display='none';
  if(Math.random()<0.42){match.wickets--;addLog('<span style="color:var(--success)">📺 Review Successful! Not Out</span>');toast('Review Successful!')}
  else{addLog('<span style="color:var(--danger)">📺 Review Lost</span>');toast('Review failed')}
  updateScoreboard();
}
function addLog(h){const l=document.getElementById('ballLog');l.innerHTML+=h+'<br>';l.scrollTop=l.scrollHeight}
function endInnings(){
  if(match.innings===1){match.target=match.score+1;match.innings=2;match.userBatting=!match.userBatting;match.score=0;match.wickets=0;match.balls=0;addLog('<br><strong>Innings over! Target: '+match.target+'</strong><br>');initOnFieldPlayers();updateScoreboard();setUserActions();toast('2nd Innings! Target '+match.target)}
  else finishMatch();
}
function finishMatch(){
  document.getElementById('playPhase').style.display='none';document.getElementById('userActions').innerHTML='';document.getElementById('drsArea').style.display='none';
  const box=document.getElementById('resultPhase');box.style.display='block';
  let won=false,resultText='';
  if(match.userBatting){if(match.score>=match.target){won=true;resultText=match.myTeam+' won by '+(match.maxWickets-match.wickets)+' wickets!'}else resultText=match.oppTeam+' won by '+(match.target-1-match.score)+' runs'}
  else{if(match.score<match.target){won=true;resultText=match.myTeam+' won by '+(match.target-1-match.score)+' runs!'}else resultText=match.oppTeam+' chased successfully'}
  state.stats.matches=(state.stats.matches||0)+1;if(won) state.stats.wins=(state.stats.wins||0)+1;
  // Fans
  if(won) state.fans=Math.min(100,state.fans+3+Math.floor(Math.random()*5));else state.fans=Math.max(8,state.fans-2-Math.floor(Math.random()*4));
  // Season
  if(match.mode==='career'){
    state.seasonMatches++;const my=state.seasonTable.find(t=>t.team===state.domesticTeam);if(my){my.played++;if(won){my.won++;my.pts+=2;state.seasonPoints+=2}}
    state.seasonTable.forEach(t=>{if(t.team!==state.domesticTeam&&Math.random()<0.35){t.played++;if(Math.random()<0.5){t.won++;t.pts+=2}}});
    if(state.seasonMatches>=6){state.season++;state.seasonMatches=0;toast('🎉 New Season '+state.season)}
  }
  // Form/Injury
  if(state.careerPlayers.length) state.careerPlayers.forEach(p=>{if(Math.random()<0.07)p.injured=true;else if(p.injured&&Math.random()<0.45)p.injured=false;p.form=Math.max(1,Math.min(10,(p.form||5)+(Math.random()<0.5?1:-1)))});
  let xp=won?26+Math.floor(Math.random()*14):9+Math.floor(Math.random()*8);let coins=won?40+Math.floor(Math.random()*28):10+Math.floor(Math.random()*12);
  coins=Math.floor(coins*(0.85+state.fans/250));if(match.mode==='national'){xp=Math.floor(xp*1.4);coins=Math.floor(coins*1.4)}
  state.careerXP+=xp;state.coins+=coins;while(state.careerXP>=100){state.careerXP-=100;state.careerLevel++;toast('🎉 Level Up! '+state.careerLevel)}
  save();updateUI();
  const headline=won?[match.myTeam+' dominate!',match.myTeam+' seal victory','Fans celebrate as '+match.myTeam+' win']:[match.oppTeam+' edge past',match.myTeam+' fall short','Tough loss for '+match.myTeam];
  box.innerHTML=`<div class="big">\( {won?'🏆':'😔'}</div><h2> \){won?'You Won!':'You Lost'}</h2>
    <p style="margin:5px 0;color:var(--muted);font-size:.88rem">${resultText}</p>
    <div class="newspaper"><div class="headline">\( {headline[Math.floor(Math.random()*headline.length)]}</div><div class="sub"> \){match.myTeam} vs ${match.oppTeam}</div></div>
    <p style="color:var(--accent)">+\( {xp} XP • + \){coins} Coins • Fans ${state.fans}</p>
    <button class="btn" style="margin-top:8px" onclick="afterMatch()">Continue</button>`;
}
function afterMatch(){goTo(match.mode==='career'||match.mode==='national'?'careerDash':'mainMenu');if(match.mode==='career'||match.mode==='national')refreshCareerDash();checkAchievements()}
