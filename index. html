  if(n) n.textContent=state.careerLevel>=8?'National unlocked!':(state.careerLevel>=3?'IPL unlocked • National at 8':'IPL at 3 • National at 8');
}
function goTo(id){document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));document.getElementById(id)?.classList.add('active');if(id==='mainMenu')updateUI()}
function skipIntro(){document.getElementById('intro').classList.add('hidden');setTimeout(()=>document.getElementById('intro').style.display='none',500)}
setTimeout(()=>{if(!document.getElementById('intro').classList.contains('hidden'))skipIntro()},2300);

// ===== CAREER =====
function startCareer(){
  if(state.careerSetupDone){goTo('careerDash');refreshCareerDash();return}
  goTo('careerCountry');
  document.getElementById('countryGrid').innerHTML=COUNTRIES.map(c=>`<div class="card" onclick="selectCountry('\( {c.name}')"><div class="icon"> \){c.flag}</div><h3>${c.name}</h3></div>`).join('');
}
function selectCountry(name){
  state.country=name;
  if(name==='India'){
    goTo('careerState');
    document.getElementById('selectedCountryText').textContent='City choose karo:';
    document.getElementById('stateGrid').innerHTML=INDIA_STATES.map(s=>`<div class="card" onclick="selectDomestic('\( {s.name}',' \){s.stadium}')"><div class="icon">🏟️</div><h3>\( {s.name}</h3><p> \){s.stadium}</p></div>`).join('');
  } else selectDomestic(name+' XI',COUNTRY_STADIUMS[name]||name+' Stadium');
}
function selectDomestic(team,stadium){
  tempTeamName=team;tempStadium=stadium;
  const pool=NAME_POOLS[state.country]||NAME_POOLS.India;
  const roles=["Batsman","Batsman","Batsman","Batsman","Batsman","WK-Batsman","All-rounder","All-rounder","All-rounder","Bowler","Bowler","Bowler","Bowler","Bowler","Batsman","All-rounder","Bowler","WK-Batsman","Batsman","Bowler"];
  tempCareerPlayers=[];const used=new Set();
  for(let i=0;i<20;i++){let n;do{n=pool[Math.floor(Math.random()*pool.length)]}while(used.has(n)&&used.size<pool.length);used.add(n);
    tempCareerPlayers.push({name:n,role:roles[i],rating:60+Math.floor(Math.random()*22),form:5,injured:false,isStar:false})}
  goTo('careerSetup');
  document.getElementById('setupTeamName').textContent=team;
  document.getElementById('setupStadium').textContent=stadium;
  document.getElementById('starPlayerName').value='';
  document.getElementById('setupPlayerList').innerHTML=tempCareerPlayers.map(p=>`<span class="player-chip">${p.name} • ${p.role}</span>`).join('');
}
function confirmCareerSetup(){
  let star=document.getElementById('starPlayerName').value.trim()||'Your Star';
  tempCareerPlayers[0].name=star;tempCareerPlayers[0].isStar=true;tempCareerPlayers[0].rating=Math.max(tempCareerPlayers[0].rating,78);
  state.domesticTeam=tempTeamName;state.careerStadium=tempStadium;state.careerPlayers=tempCareerPlayers;state.starPlayerName=star;state.careerSetupDone=true;state.captain=star;
  state.seasonTable=[{team:state.domesticTeam,played:0,won:0,pts:0},{team:'Warriors',played:0,won:0,pts:0},{team:'Strikers',played:0,won:0,pts:0},{team:'Titans',played:0,won:0,pts:0},{team:'Blasters',played:0,won:0,pts:0}];
  save();goTo('careerDash');refreshCareerDash();toast('✅ Career ready!');
}
function refreshCareerDash(){
  document.getElementById('dashTeam').textContent=state.domesticTeam;
  document.getElementById('dashStadium').textContent=state.careerStadium;
  document.getElementById('dashLevel').textContent=state.careerLevel;
  document.getElementById('dashXP').textContent=state.careerXP;
  document.getElementById('dashSeason').textContent=state.season;
  document.getElementById('dashPoints').textContent=state.seasonPoints;
  document.getElementById('nationalCard').style.display=state.careerLevel>=8?'block':'none';
}
function viewCareerSquad(){
  goTo('careerSquadView');
  document.getElementById('careerSquadList').innerHTML=state.careerPlayers.map(p=>`
    <div class="card" style="cursor:default;\( {p.isStar?'border-color:var(--gold)':''} \){p.injured?';opacity:.55':''}">
      <h3 style="font-size:.8rem">\( {p.isStar?'⭐ ':''} \){p.name}</h3>
      <p>${p.role} • ${p.rating}</p>
      <p style="font-size:.7rem">Form ${p.form||5}/10 ${p.injured?'• Injured':''}</p>
      <button class="btn btn-sm" style="margin-top:3px" onclick="setCaptain('\( {p.name}')"> \){state.captain===p.name?'Captain':'Make Captain'}</button>
    </div>`).join('');
}
function setCaptain(name){state.captain=name;save();toast('Captain: '+name);viewCareerSquad()}
function openSeasonTable(){
  goTo('seasonTable');
  const sorted=[...state.seasonTable].sort((a,b)=>b.pts-a.pts||b.won-a.won);
  document.getElementById('tableBody').innerHTML=`<table style="width:100%;font-size:.84rem;border-collapse:collapse"><tr style="color:var(--muted)"><th style="text-align:left;padding:5px">Team</th><th>P</th><th>W</th><th>Pts</th></tr>
    \( {sorted.map((t,i)=>`<tr style=" \){t.team===state.domesticTeam?'color:var(--accent);font-weight:700':''}"><td style="padding:5px">${i+1}. \( {t.team}</td><td style="text-align:center"> \){t.played}</td><td style="text-align:center">\( {t.won}</td><td style="text-align:center"> \){t.pts}</td></tr>`).join('')}</table>`;
}
function openCareerStats(){
  goTo('careerStats');
  const s=state.stats;
  document.getElementById('statsBody').innerHTML=`<p>Matches: <strong>\( {s.matches||0}</strong></p><p style="margin-top:5px">Wins: <strong> \){s.wins||0}</strong></p>
    <p style="margin-top:5px">Win %: <strong>${s.matches?Math.round((s.wins||0)/s.matches*100):0}%</strong></p>
    <p style="margin-top:5px">Sixes: <strong>\( {s.sixes||0}</strong> • Fours: <strong> \){s.fours||0}</strong></p>
    <p style="margin-top:5px">Season Pts: <strong>\( {state.seasonPoints}</strong> • Fans: <strong> \){state.fans}</strong></p>`;
}
function resetCareerConfirm(){if(confirm('Career reset?')){state.careerSetupDone=false;state.careerPlayers=[];state.season=1;state.seasonPoints=0;state.seasonMatches=0;state.seasonTable=[];state.captain=null;save();toast('Reset done');goTo('mainMenu')}}
