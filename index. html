let state = {
  careerLevel:1, careerXP:0, coins:200, fans:50,
  country:null, domesticTeam:null, careerStadium:null, careerPlayers:[], careerSetupDone:false, starPlayerName:"",
  captain:null, season:1, seasonPoints:0, seasonMatches:0, seasonTable:[],
  coaches:{batting:false,bowling:false,fielding:false}, sound:true,
  iplTeam:null, budget:30, squad:[], soldPlayers:new Set(), myIntlTeam:null,
  stats:{matches:0,wins:0,sixes:0,fours:0}, lastDaily:null, achievements:{}, fieldSetting:'balanced',
  trainingDone:{}, challenges:{}, lastChallenge:null
};
let match=null, auctionPool=[], currentAuctionPlayer=null, selectedOvers=5, lastScreenBeforeOvers='mainMenu', matchMode='career';
let selectedOpp=null, selectedBats=[], selectedBowls=[], feedbackRating=0, cup=null;
let tempCareerPlayers=[], tempStadium="", tempTeamName="", pendingPack=null, currentPitch=null, currentWeather=null, reviewsLeft=1;

function toast(m){const t=document.getElementById('toast');t.textContent=m;t.style.display='block';setTimeout(()=>t.style.display='none',2200)}
function save(){localStorage.setItem('ccm_v9',JSON.stringify({...state,soldPlayers:[...state.soldPlayers]}))}
function load(){try{const d=JSON.parse(localStorage.getItem('ccm_v9'));if(d){state={...state,...d};state.soldPlayers=new Set(d.soldPlayers||[])}}catch(e){}}
function updateUI(){
  document.getElementById('careerLevel').textContent=state.careerLevel;
  document.getElementById('careerXP').textContent=state.careerXP;
  document.getElementById('coinDisplay').textContent=state.coins;
  document.getElementById('fanDisplay').textContent=state.fans;
